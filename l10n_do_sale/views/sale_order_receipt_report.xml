<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="name">Recibo de Venta / Separación</field>
        <field name="report_name">l10n_do_sale.report_sale_separation_receipt</field>
        <field name="report_file">l10n_do_sale.report_sale_separation_receipt</field>
        <field name="print_report_name">'Recibo Venta Separacion - %s' % (object.name)</field>
    </record>

    <record id="account.account_invoices" model="ir.actions.report">
        <field name="name">Recibo de Venta / Separación</field>
        <field name="report_name">l10n_do_sale.report_sale_separation_receipt</field>
        <field name="report_file">l10n_do_sale.report_sale_separation_receipt</field>
        <field name="print_report_name">'Recibo Venta Separacion - %s' % (object.name)</field>
    </record>

    <record id="account.account_invoices_without_payment" model="ir.actions.report">
        <field name="name">Recibo de Venta / Separación</field>
        <field name="report_name">l10n_do_sale.report_sale_separation_receipt</field>
        <field name="report_file">l10n_do_sale.report_sale_separation_receipt</field>
        <field name="print_report_name">'Recibo Venta Separacion - %s' % (object.name)</field>
    </record>

    <record id="action_report_sale_separation_receipt" model="ir.actions.report">
        <field name="name">Recibo de Venta / Separación</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_do_sale.report_sale_separation_receipt</field>
        <field name="report_file">l10n_do_sale.report_sale_separation_receipt</field>
        <field name="print_report_name">'Recibo Venta Separacion - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_saleorder_standard" model="ir.actions.report">
        <field name="name">Cotización / Pedido estándar</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale.report_saleorder</field>
        <field name="report_file">sale.report_saleorder</field>
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'Quotation - %s' % (object.name)) or 'Order - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_invoice_standard" model="ir.actions.report">
        <field name="name">Factura estándar con pagos</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account.report_invoice_with_payments</field>
        <field name="report_file">account.report_invoice_with_payments</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_invoice_without_payment_standard" model="ir.actions.report">
        <field name="name">Factura estándar sin pagos</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account.report_invoice</field>
        <field name="report_file">account.report_invoice</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_sale_separation_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="receipt" t-value="doc._get_sale_receipt_values()"/>
                <t t-set="vehicle" t-value="receipt.get('vehicle')"/>
                <t t-call="web.external_layout">
                    <div class="page" style="font-size: 13px; line-height: 1.35;">
                        <style>
                            .fcr-receipt-table {
                                width: 100%;
                                border-collapse: collapse;
                            }
                            .fcr-receipt-table td {
                                padding: 2px 4px;
                                vertical-align: top;
                            }
                            .fcr-label {
                                font-weight: 700;
                                white-space: nowrap;
                            }
                            .fcr-value {
                                border-bottom: 1px solid #111;
                                min-height: 18px;
                            }
                            .fcr-amount-label {
                                width: 34%;
                                font-weight: 700;
                            }
                            .fcr-amount-currency {
                                width: 8%;
                                text-align: center;
                                font-weight: 700;
                            }
                            .fcr-amount-value {
                                width: 20%;
                                text-align: right;
                                border-bottom: 1px solid #111;
                            }
                            .fcr-note {
                                width: 38%;
                                font-size: 12px;
                            }
                        </style>

                        <p class="text-end mb-4" t-esc="receipt.get('date_text')"/>

                        <table class="fcr-receipt-table mb-3">
                            <tr>
                                <td class="fcr-label" style="width: 16%;">Cliente:</td>
                                <td class="fcr-value" style="width: 84%;" t-esc="receipt.get('client')"/>
                            </tr>
                            <tr>
                                <td class="fcr-label">RNC/Cédula:</td>
                                <td class="fcr-value" t-esc="receipt.get('vat')"/>
                            </tr>
                            <tr>
                                <td class="fcr-label">Teléfono:</td>
                                <td class="fcr-value" t-esc="receipt.get('phone')"/>
                            </tr>
                            <tr>
                                <td class="fcr-label">E-mail:</td>
                                <td class="fcr-value" t-esc="receipt.get('email')"/>
                            </tr>
                        </table>

                        <p class="my-4">
                            Por medio de la presente hacemos constar que hemos recibido de la persona descrita más arriba
                            los siguientes pagos, para completar a futuro con el pago total del vehículo descrito a
                            continuación:
                        </p>

                        <table class="fcr-receipt-table mb-4">
                            <tr>
                                <td class="fcr-label">Marca:</td>
                                <td class="fcr-value" t-esc="vehicle.get('brand')"/>
                                <td class="fcr-label">Modelo:</td>
                                <td class="fcr-value" t-esc="vehicle.get('model')"/>
                                <td class="fcr-label">Año:</td>
                                <td class="fcr-value" t-esc="vehicle.get('year')"/>
                            </tr>
                            <tr>
                                <td class="fcr-label">Placa:</td>
                                <td class="fcr-value" t-esc="vehicle.get('license_plate')"/>
                                <td class="fcr-label">Chasis:</td>
                                <td class="fcr-value" t-esc="vehicle.get('chassis')"/>
                                <td class="fcr-label">Kms-Millas:</td>
                                <td class="fcr-value" t-esc="vehicle.get('mileage')"/>
                            </tr>
                            <tr>
                                <td class="fcr-label">Color:</td>
                                <td class="fcr-value" t-esc="vehicle.get('color')"/>
                                <td class="fcr-label">Tipo:</td>
                                <td class="fcr-value" colspan="3" t-esc="vehicle.get('type')"/>
                            </tr>
                        </table>

                        <table class="fcr-receipt-table mb-4">
                            <tr>
                                <td class="fcr-amount-label">Pago inicial:</td>
                                <td class="fcr-amount-currency" t-esc="receipt.get('currency').symbol or receipt.get('currency').name"/>
                                <td class="fcr-amount-value">
                                    <span t-esc="'{:,.2f}'.format(receipt.get('initial_payment') or 0.0)"/>
                                </td>
                                <td class="fcr-note">
                                    De ser en pesos especificar día y tasa de recepción
                                    <span t-if="receipt.get('exchange_rate')">
                                        : <span t-esc="receipt.get('exchange_rate')"/>
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td class="fcr-amount-label">Costo total del vehículo:</td>
                                <td class="fcr-amount-currency" t-esc="receipt.get('currency').symbol or receipt.get('currency').name"/>
                                <td class="fcr-amount-value">
                                    <span t-esc="'{:,.2f}'.format(receipt.get('total_cost') or 0.0)"/>
                                </td>
                                <td class="fcr-note">(Incluye traspaso)</td>
                            </tr>
                            <tr>
                                <td class="fcr-amount-label">Pendiente a pagar:</td>
                                <td class="fcr-amount-currency" t-esc="receipt.get('currency').symbol or receipt.get('currency').name"/>
                                <td class="fcr-amount-value">
                                    <span t-esc="'{:,.2f}'.format(receipt.get('balance') or 0.0)"/>
                                </td>
                                <td class="fcr-note">(Carta BANCO)</td>
                            </tr>
                        </table>

                        <p class="mt-4">
                            <strong>Nota:</strong>
                            La separación del vehículo descrito en la parte de arriba conlleva un mínimo de un 10%.
                            De no concluir con el pago total en 7 días laborables a partir de la fecha del documento,
                            se procede con la devolución del mismo, reteniéndole un 20% de la separación o inicial.
                        </p>

                        <div class="mt-5" style="width: 45%; text-align: center;">
                            <div style="border-top: 1px solid #111; padding-top: 6px;">
                                <div t-esc="receipt.get('executive') or 'No especificado'"/>
                                <strong>FCR AUTOS, SRL</strong>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
