<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ecf_configuration_view_form" model="ir.ui.view">
        <field name="name">ecf.configuration.view.form</field>
        <field name="model">ecf.settings</field>
        <field name="arch" type="xml">
            <form string="Electronic Vouchers Configuration">
                <header>
                    <button
                        name="action_validate_and_load"
                        string="Validate Cert"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'unverified'"/>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group string="General">
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="environment"/>
                            <field name="company_id" groups="base.group_multi_currency"/>
                            <field name="access_token" invisible="1"/>
                            <field name="access_token_expires_in" invisible="1"/>
                        </group>
                    </group>
                    <group string="Certificate info">
                        <group>
                            <field name="ce_p12_file" filename="ce_p12_name"/>
                            <field name="ce_p12_name" invisible="1"/>
                        </group>
                        <group>
                            <field name="ce_p12_pin" password="True"/>
                        </group>
                        <div>
                            <button name="action_verify" type="object" string="Validate Semilla" class="oe_highlight"
                                    invisible="not ce_p12_file or not ce_p12_pin"/>
                        </div>
                    </group>
                    <notebook colspan="2">
                        <page string="Cert Info">
                            <group invisible="state == 'unverified'">
                                <field name="issue_date"/>
                                <field name="subject_common_name"/>
                                <field name="subject_serial_number" groups="base.group_system"/>
                                <field name="expire_date"/>
                                <field name="issuer_common_name"/>
                                <field name="cert_serial_number" groups="base.group_system"/>
                                <field name="cert_version" groups="base.group_system"/>
                            </group>
                        </page>
                        <page string="Notification">
                            <group>
                                <field name="days_for_notification" required="1" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ecf_configuration_view_tree" model="ir.ui.view">
        <field name="name">ecf.configuration.view.tree</field>
        <field name="model">ecf.settings</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="environment"/>
            </list>
        </field>
    </record>
    <record id="ecf_configuration_view_kanban" model="ir.ui.view">
        <field name="name">ecf.configuration.view.kanban</field>
        <field name="model">ecf.settings</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="environment"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_title">
                                    <field name="name"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="environment"/>
                                </div>
                                <div class="oe_clear"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
