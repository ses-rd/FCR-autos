<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="l10n_do_ecf_report_invoice_document" inherit_id="account.report_invoice_document">
        <!-- Hide when is_l10n_do_invoice -->
        <xpath expr="//div[@name='comment']" position="attributes">
            <attribute name="t-if">not is_l10n_do_invoice</attribute>
        </xpath>
        <xpath expr="//div[@id='qrcode']" position="after">
            <div class="text-muted mb-3" t-attf-style="#{'text-align:justify;text-justify:inter-word;' if o.company_id.terms_type != 'html' else ''}" t-if="not is_html_empty(o.narration)" name="comment">
                <span t-field="o.narration"/>
            </div>
            <div t-if="ecf_representation and o.l10n_do_electronic_stamp" id="l10n_do_qrcode">
                <div>
                    <img width="150" height="150" class="media-object" t-att-src="image_data_uri(o.QR_code)"/>
                </div>
                <table style="font-size:11px;" class="table-condensed table-borderless">
                    <tr t-if="o.l10n_do_ecf_security_code">
                        <td>
                            <strong>Security Code: </strong>
                            <span t-field="o.l10n_do_ecf_security_code"/>
                        </td>
                    </tr>
                    <tr t-if="o.l10n_do_ecf_sign_date">
                        <td>
                            <strong>Sign Date: </strong>
                            <span t-field="o.l10n_do_ecf_sign_date"/>
                        </td>
                    </tr>
                </table>
            </div>
        </xpath>
    </template>
</odoo>