<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ecf_document_view_search" model="ir.ui.view">
        <field name="name">ecf.document.view.search</field>
        <field name="model">ecf.document</field>
        <field name="arch" type="xml">
            <search string="Documentos">
                <field name="name"/>
                <field name="partner_id"/>
                <group>
                    <filter string="Document Type" name="filter_l10n_latam_document_type_id" context="{'group_by': 'l10n_latam_document_type_id'}"/>
                    <filter string="ECF Send State" name="filter_l10n_do_ecf_send_state" context="{'group_by': 'l10n_do_ecf_send_state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="ecf_document_tree_view" model="ir.ui.view">
        <field name="name">ecf.document.tree.view</field>
        <field name="model">ecf.document</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" duplicate="0">
                <field name="name"/>
                <field name="create_date"/>
                <field name="l10n_latam_document_type_id"/>
                <field name="partner_id"/>
                <field name="xml_amount_tax" sum="Amount Total Tax" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                <field name="xml_amount_total" sum="Amount Total" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                <field name="company_currency_id" optional="hidden"/>
                <field name="state_mail" widget="badge" decoration-success="state_mail == 'sent'"/>
                <field name="customer_decision" widget="badge"
                       decoration-danger="customer_decision == 'reject'"
                       decoration-success="customer_decision in ('accepted', 'system_accepted')"
                       decoration-info="customer_decision == 'pending'"/>
                  <field name="l10n_do_acecf_send_state" optional="hide" widget="badge"
                      decoration-danger="l10n_do_acecf_send_state == 'reject'"
                       decoration-success="l10n_do_acecf_send_state == 'accepted'"
                       decoration-info="customer_decision == 'pending'"/>
                  <field name="l10n_do_ecf_send_state" widget="badge"
                       decoration-danger="l10n_do_ecf_send_state in ('invalid', 'delivered_refused')"
                       decoration-warning="l10n_do_ecf_send_state in ('contingency', 'delivered_pending', 'delivered_pending', 'not_sent',  'service_unreachable', 'signed_pending')"
                       decoration-success="l10n_do_ecf_send_state in ('delivered_accepted', 'conditionally_accepted')"
                       decoration-info="l10n_do_ecf_send_state == 'to_send'"/>
                <field name="state" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="ecf_document_form_view" model="ir.ui.view">
        <field name="name">ecf.document.form.view</field>
        <field name="model">ecf.document</field>
        <field name="arch" type="xml">
            <form string="Electronic Document" edit="0" create="0" duplicate="false" delete="0">
                <header>
                    <button name="action_gen_xml" type="object" string="Gen XML" class="oe_highlight"
                            invisible="xml_file != False or l10n_do_ecf_send_state != 'to_send'"/>
                    <button name="action_send_to_dgii" type="object" string="Send DGII" class="oe_highlight"
                            invisible="l10n_do_ecf_send_state not in ['signed_pending', 'not_sent', 'not_found'] or not xml_file"/>
                    <button name="action_request_state_to_dgii" type="object" string="Request State DGII"
                            class="oe_highlight"
                            invisible="l10n_do_ecf_send_state != 'delivered_pending' or not xml_file"/>
                    <button name="action_send_mail" type="object" invisible="l10n_do_ecf_send_state not in ['delivered_accepted', 'conditionally_accepted'] or is_rfce or state_mail in ['not_mail', 'sent']"
                            string="Send Email" class="oe_highlight"/>

<!--                    <button name="action_send_to_receptor" type="object" invisible="l10n_do_ecf_send_state not in ['delivered_accepted', 'conditionally_accepted'] or is_rfce or state_mail in ['not_mail', 'sent']"-->
<!--                            string="Send to Receptor" help="Send to Receptor via API" class="oe_highlight"/>-->
                    <field name="l10n_do_ecf_send_state" widget="statusbar" statusbar_visible="signed_pending,delivered_accepted,delivered_refused"/>
                    <field name="state" invisible="1"/>
                </header>
                <sheet string="Electronic Documents">
                    <!-- Invisible fields -->
                    <field name="is_ref" invisible="1"/>
                    <field name="sequence_used" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <img src='/l10n_do_ecf/static/img/logo_dgii.png' width="140px" heigth="60px" alt="DGII Logo"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="invoice_id" invisible="not invoice_id" groups="account.group_account_invoice"/>
                            <field name="l10n_latam_document_type_id"/>
                            <field name="partner_id"/>
                            <field name="ncf_type" invisible="1"/>
                            <field name="state_mail"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_rfce" invisible="ncf_type != '32'"/>
                        </group>
                        <group>
                            <field name="xml_file" readonly="1" filename="xml_file_name"/>
                            <field name="xml_file_name" readonly="1" invisible="1"/>
                            <field name="xml_rfce_file" readonly="1" filename="xml_rfce_file_name"
                                   invisible="not is_rfce"/>
<!--                                   invisible="not is_rfce or l10n_do_ecf_send_state not in ['delivered_accepted', 'conditionally_accepted', 'delivered_pending', 'delivered_refused']"/>-->
                            <field name="xml_rfce_file_name" readonly="1" invisible="1"/>
                            <field name="xml_amount_tax" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                            <field name="xml_amount_total" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                            <field name="company_currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <group>
                        <group string="Commercial Approved">
                            <field name="customer_decision"/>
                            <field name="date_acknowledgment" invisible="customer_decision not in ['accepted', 'system_accepted']"/>
                            <field name="xml_commercial_approval_file" readonly="1"
                                   invisible="not xml_commercial_approval_file"
                                   filename="xml_commercial_approval_file_name"/>
                            <field name="xml_commercial_approval_file_name" readonly="1" invisible="1"/>
                            <field name="l10n_do_acecf_send_state"/>
                            <field name="reject_reason"
                                   invisible="customer_decision != 'reject'"/>
                        </group>
                    </group>
                    <notebook colspan="4">
                        <page string="Message DGII" name="message_dgii">
                            <button name="action_consultatrackids" type="object" string="Request Trackids"
                                    class="oe_highlight mb-2"
                                    invisible="state != 'invoice_sent' or is_rfce or not xml_file"/>
                            <br/>
                            <button name="action_consultaestado" type="object" string="Consulta de estado e‐CF"
                                    class="oe_highlight mb-2"
                                    invisible="state != 'invoice_sent' or not is_rfce or not xml_file"/>
                            <group>
                                <group invisible="not xml_dgii_file" id="dgii_message">
                                    <field name="xml_dgii_file" readonly="1" filename="xml_dgii_file_name"/>
                                    <field name="xml_dgii_file_name" readonly="1" invisible="1"/>
                                    <field name="message_detail_dgii"/>
                                    <field name="response_status_code" groups="base.group_no_one"/>
                                </group>
                                <group invisible="not xml_dgii_acecf_file" id="dgii_acecf_message">
                                    <field name="xml_dgii_acecf_file" readonly="1" filename="xml_dgii_acecf_file_name"/>
                                    <field name="xml_dgii_acecf_file_name" readonly="1" invisible="1"/>
                                    <field name="message_detail_dgii_acecf"/>
                                </group>
                            </group>
                        </page>
                        <page string="QR" name="qr_code">
                            <group>
                                <group>
                                    <field name="QR_code" widget="image"
                                           invisible="not QR_code or l10n_do_ecf_send_state == 'to_send'" nolabel="1"/>
                                </group>
                                <group>
                                    <field name="l10n_do_ecf_security_code" invisible="1"/>
                                    <field name="l10n_do_ecf_sign_date" invisible="1"/>
                                    <field name="l10n_do_electronic_stamp" readonly="1"
                                           invisible="not l10n_do_electronic_stamp or l10n_do_ecf_send_state == 'to_send'"
                                           widget="CopyClipboardChar"/>
                                </group>
                            </group>
                        </page>
                        <page string="Registry Information" name="registry_information" groups="base.group_no_one">
                            <group>
                                <group>
                                    <field name="create_date"/>
                                    <field name="date_signed"/>
                                </group>
                            </group>
                        </page>
                        <page string="References" invisible="not is_ref">
                            <field name="ref_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="ref_reason"/>
                                    <field name="ref_number"/>
                                    <field name="ref_date"/>
                                    <button type="object" name="action_view_document_reference" string="Show"/>
                                    <button type="object" name="action_download_file" string="Download"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_ecf_document_action" model="ir.actions.act_window">
        <field name="name">Electronic Documents</field>
        <field name="res_model">ecf.document</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Haga clic para agregar un documento.
            </p>
            <p>
                Una documento es un registro de la compañia a la DGII que genera la facturación electrónica.
            </p>
        </field>
    </record>
</odoo>
