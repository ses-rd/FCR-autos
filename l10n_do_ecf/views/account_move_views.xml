<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_invoice_tree_inherit" model="ir.ui.view">
        <field name="name">view.invoice.tree.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="status_in_payment" position="after">
                <field name="is_exportation" optional="hidden"/>
                <field name="customer_decision" widget="badge"
                       decoration-danger="customer_decision == 'reject'"
                       decoration-success="customer_decision in ('accepted', 'system_accepted')"
                       decoration-info="customer_decision == 'pending'"/>
                <field name="l10n_do_ecf_send_state" widget="badge"
                       decoration-danger="l10n_do_ecf_send_state in ('invalid', 'delivered_refused')"
                       decoration-warning="l10n_do_ecf_send_state in ('contingency', 'delivered_pending', 'delivered_pending', 'not_sent', 'service_unreachable', 'signed_pending')"
                       decoration-success="l10n_do_ecf_send_state in ('delivered_accepted', 'conditionally_accepted')"
                       decoration-info="l10n_do_ecf_send_state == 'to_send'"/>
            </field>
        </field>
    </record>
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">view.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <form position="inside">
                <!-- Invisible fields -->
                <field name="l10n_do_is_ecf_needed" invisible="1"/>
                <field name="is_rfce" invisible="1"/>
                <field name="l10n_do_message_detail" invisible="1"/>
            </form>
            <xpath expr="//header" position="after">
                <div class="alert alert-danger" role="alert" invisible="not ecf_warning_message">
                    <field name="ecf_warning_message" style="width:auto !important;"/>
                    <button name="action_recreate_xml" type="object" string="Retry" class="oe_link oe_inline"
                            invisible="l10n_do_ecf_send_state not in ['to_send']"
                            groups="account.group_account_invoice"/>
                </div>
                <div class="alert alert-info mb-0" role="alert"
                    invisible="l10n_do_ecf_send_state not in ['signed_pending', 'not_sent'] or state != 'posted'">
                    Este servicio de facturación electrónica procesará la factura asincronicamente
                    <button class="btn btn-link p-0" type="object" name="action_send_to_dgii"
                            style="padding: 0; vertical-align: baseline;">Enviar a DGII ahora</button>.
                </div>
                <div class="alert alert-info mb-0" role="alert"
                     invisible="l10n_do_ecf_send_state != 'delivered_pending' or state != 'posted'">
                    El comprobante aun no ha sido validado <button class="btn btn-link p-0" type="object"
                                                                   name="action_request_state_to_dgii"
                                                                   style="padding: 0; vertical-align: baseline;">
                    Consultar estado a la DGII ahora</button>.
                </div>
            </xpath>
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="l10n_do_ecf_payment_method" invisible="not l10n_do_is_ecf_needed"
                       readonly="state != 'draft'"/>
                <field name="is_rfce" invisible="1"/>
                <label for="ecf_id" invisible="not ecf_id or not l10n_do_is_ecf_needed"/>
                <div invisible="not ecf_id or not l10n_do_is_ecf_needed">
                    <field name="ecf_id" invisible="not ecf_id"/>
                    <div class="text-muted" invisible="not is_rfce">
                        Resumen Factura de Consumo Electrónica (RD$250,000) (RFCE)
                    </div>
                </div>
                <field name="l10n_do_ecf_send_state" invisible="not ecf_id or not l10n_do_is_ecf_needed" widget="l10n_do_document_state"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page id="dgii_documents" string="Facturación Electrónica" invisible="not ecf_id or not l10n_do_is_ecf_needed">
                    <group>
                        <group>
                            <field name="customer_decision"/>
                            <div class="text-muted" colspan="4">
                                Un documento electrónico que no tenga una aprobación comercial por parte del cliente en
                                un termino de 3 días, se establece de forma automática su estado a "Aprobado por el
                                sistema" y posterior se envía a la DGII de oficio.
                            </div>
                        </group>
                    </group>
                    <group>
                        <group invisible="l10n_do_ecf_send_state not in ['delivered_accepted', 'conditionally_accepted']">
                            <field name="QR_code" widget="image" nolabel="1"/>
                        </group>
                        <group invisible="l10n_do_ecf_send_state not in ['delivered_accepted', 'conditionally_accepted']">
                            <field name="l10n_do_ecf_security_code" invisible="1"/>
                            <field name="l10n_do_ecf_sign_date" invisible="1"/>
                            <field name="l10n_do_electronic_stamp" widget="CopyClipboardChar"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="l10n_do_ecf_date_modification"
                       invisible="not (move_type in ('in_refund', 'out_refund') or debit_origin_id) or not (is_ecf_invoice or country_code == 'DO')"
                       required="move_type in ('in_refund', 'out_refund') and is_ecf_invoice and debit_origin_id != False"
                       readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>
    <record id="view_account_invoice_filter_inherit" model="ir.ui.view">
        <field name="name">view.account.invoice.filter.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/group/filter[@name='status']" position="after">
                <filter string="DGII State" name="dgii_state" context="{'group_by': 'l10n_do_ecf_send_state'}"/>
            </xpath>
        </field>
    </record>
    <record id="action_invoice_exportation" model="ir.actions.act_window">
        <field name="name">Exportation Invoice</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_invoice_tree"/>
        <field name="domain">[('is_exportation', '=', True)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una Factura de Exportación
            </p>
        </field>
    </record>
    <menuitem id="ecf_menu_invoice_exportation" name="Exportation Invoice" action="action_invoice_exportation"
              parent="account.menu_finance_receivables" sequence="3"/>
</odoo>
