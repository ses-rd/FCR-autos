<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="acecf_document_view_search" model="ir.ui.view">
        <field name="name">acecf.document.view.search</field>
        <field name="model">acecf.document</field>
        <field name="arch" type="xml">
            <search string="Document">
                <field name="name"/>
                <field name="partner_id"/>
            </search>
        </field>
    </record>
    <record id="acecf_document_tree_view" model="ir.ui.view">
        <field name="name">acecf.document.tree.view</field>
        <field name="model">acecf.document</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" duplicate="0">
                <field name="name"/>
                <field name="invoice_id"/>
                <field name="company_id"/>
                <field name="partner_id"/>
                <field name="xml_amount_total" sum="Amount Total" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                <field name="company_currency_id" optional="hidden"/>
                <field name="customer_decision" widget="badge"
                       decoration-danger="customer_decision == 'reject'"
                       decoration-success="customer_decision in ('accepted', 'system_accepted')"
                       decoration-info="customer_decision == 'pending'"/>
                <field name="l10n_do_acecf_send_state" widget="badge"
                       decoration-danger="l10n_do_acecf_send_state == 'reject'"
                       decoration-success="l10n_do_acecf_send_state == 'accepted'"
                       decoration-info="customer_decision == 'pending'"/>
            </list>
        </field>
    </record>
    <record id="acecf_document_form_view" model="ir.ui.view">
        <field name="name">acecf.document.form.view</field>
        <field name="model">acecf.document</field>
        <field name="arch" type="xml">
            <form string="Electronic Document" edit="0" create="0" duplicate="false" delete="0">
                <sheet string="Electronic Documents">
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="xml_amount_total" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                            <field name="company_currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <group>
                        <group string="Customer Decision">
                            <field name="customer_decision"/>
                            <field name="date_acknowledgment" invisible="customer_decision not in ['accepted', 'system_accepted']"/>
                            <div class="text-muted" colspan="2">
                                Un documento electrónico que no tenga una aprobación comercial por parte del cliente en
                                un termino de 3 días, se establece de forma automática su estado a "Aprobado por el
                                sistema" y posterior se envía a la DGII de oficio.
                            </div>
                        </group>
                        <group string="Commercial Approved">
                            <field name="xml_commercial_approval_file" readonly="1"
                                   invisible="not xml_commercial_approval_file"
                                   filename="xml_commercial_approval_file_name"/>
                            <field name="xml_commercial_approval_file_name" readonly="1" invisible="1"/>
                            <field name="l10n_do_acecf_send_state"/>
                            <field name="response_status_code"/>
                            <field name="reject_reason"
                                   invisible="state_inv_supplier != '2'"/>
                        </group>
                    </group>
                    <notebook colspan="4">
                        <page string="Message DGII" name="message_dgii">
                            <group>
                                <group invisible="not xml_dgii_acecf_file" id="dgii_acecf_message">
                                    <field name="xml_dgii_acecf_file" readonly="1" filename="xml_dgii_acecf_file_name"/>
                                    <field name="xml_dgii_acecf_file_name" readonly="1" invisible="1"/>
                                    <field name="message_detail_dgii_acecf" groups="base.group_no_one"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
