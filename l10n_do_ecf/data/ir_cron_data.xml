<odoo noupdate="1">
    <record id="ecf_cron_invoices_send_dgii" model="ir.cron">
        <field name="name">ECF: Send Invoice to DGII</field>
        <field name="model_id" ref="l10n_do_ecf.model_ecf_document"/>
        <field name="state">code</field>
        <field name="code">model.cron_ecf_invoices_send_dgii(max_doc=10)</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="ecf_cron_invoices_not_sent" model="ir.cron">
        <field name="name">ECF: Invoice Not Sent to DGII (With Error)</field>
        <field name="model_id" ref="l10n_do_ecf.model_ecf_document"/>
        <field name="state">code</field>
        <field name="code">model.cron_ecf_invoices_not_sent(max_doc=10)</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="ecf_cron_invoices_delivered_pending" model="ir.cron">
        <field name="name">ECF: Send Invoice Pending to DGII</field>
        <field name="model_id" ref="l10n_do_ecf.model_ecf_document"/>
        <field name="state">code</field>
        <field name="code">model.cron_ecf_invoices_pending_send_dgii(max_doc=10)</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="ecf_cron_send_mails" model="ir.cron">
        <field name="name">ECF: Envio Email a clientes</field>
        <field name="model_id" ref="l10n_do_ecf.model_ecf_document" />
        <field name="state">code</field>
        <field name="code">model._send_mail(max_mails=10)</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
