<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_cr_invoice_pos_recreate_wizard_form" model="ir.ui.view">
        <field name="name">l10n_cr_invoice_pos.recreate.wizard.form</field>
        <field name="model">l10n_do_ecf_invoice.recreate.wizard</field>
        <field name="arch" type="xml">
            <form>
                <!-- Invisible fields -->
                <field name="move_ids" invisible="1"/>

                <div class="text-muted">
                    Esta acción solo tendrá efecto sobre ecf q no tengan establecido el campo sequence_used.
                </div>
                <footer>
                    <button string="Create"
                            data-hotkey="q"
                            name="action_recreate_invoice"
                            type="object"
                            class="print btn-primary o_mail_send">
                    </button>
                    <button string="Cancel"
                            data-hotkey="x"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record model="ir.actions.server" id="action_l10n_cr_invoice_pos_recreate">
        <field name="name">Recreate Invoices</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="binding_view_types">list</field>
        <field name="code">
if records:
    action = records.l10n_do_invoice_recreate_wizard()
        </field>
    </record>
</odoo>
