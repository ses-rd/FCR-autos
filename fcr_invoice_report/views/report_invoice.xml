        <xpath expr="//div[@id='right-elements']/div[@id='total']" position="replace">
            <div id="total" class="clearfix row">
                <div class="ms-auto">
                    <table id="invoice_totals" class="hidden-border" width="100%" style="float: right;">
                        <tr t-if="o.amount_discount">
                            <td class="table-title px-1 py-0 m-0"><b>Descuentos:</b></td>
                            <td class="px-1 py-0 m-0" style="text-align: right;"><span t-field="o.amount_discount"/></td>
                        </tr>
                        <tr>
                            <td class="table-title px-1 py-0 m-0"><b>Sub-total:</b></td>
                            <td class="px-1 py-0 m-0" style="text-align: right;"><span t-field="o.amount_untaxed"/></td>
                        </tr>
                        <tr t-foreach="o._get_totals()" t-as="tax_total">
                            <td class="table-title px-1 py-0 m-0"><b t-esc="tax_total.get('base_name')"></b></td>
                            <td class="px-1 py-0 m-0" style="text-align: right;"><t t-esc="tax_total.get('tax_amount')"
                                                                                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"
                            /></td>
                        </tr>
                        <tr>
                            <td class="table-title px-1 py-0 m-0"><b>Monto Total:</b></td>
                            <td class="px-1 py-0 m-0" style="text-align: right;"><span t-field="o.amount_total"/></td>
                        </tr>
                    </table>
                </div>
            </div>
        </xpath>
