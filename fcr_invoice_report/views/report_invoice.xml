<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="l10n_sv_report_invoice_document1" inherit_id="account.report_invoice_document">
        <xpath expr="//t[@t-set='o']" position="after">
            <t t-set="display_color"  t-value="any(l.color for l in o.invoice_line_ids)"/>
       </xpath>
        <xpath expr="//div[@id='right-elements']/div[@id='total']" position="replace">
            <div id="total" class="clearfix row">
                <div class="ms-auto">
                    <table id="invoice_totals" class="hidden-border" width="100%" style="float: right;">
                        <tr t-if="o.amount_discount">
                            <td class="table-title px-1 py-0 m-0"><b>Descuentos:</b></td>
                            <td class="px-1 py-0 m-0" style="text-align: right;"><span t-field="o.amount_discount"/></td>
                        </tr>
                        <tr>
                            <td class="table-title px-1 py-0 m-0"><b>Sub-total:</b></td>
                            <t t-set="adjusted_subtotal" t-value="o.amount_untaxed - sum([c.get('other_amount', 0.0) for c in o._get_co2_totals()]) - sum([f.get('other_amount', 0.0) for f in o._get_first_registration_totals()]) - sum([m.get('other_amount', 0.0) for m in o._get_marbete_totals()])"/>

<!--                            <td class="px-1 py-0 m-0" style="text-align: right;"><span t-field="o.amount_untaxed"/></td>-->
                            <td class="px-1 py-0 m-0" style="text-align: right;"><span t-esc="adjusted_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                        </tr>
                        <tr t-foreach="o._get_totals()" t-as="tax_total">
                            <td class="table-title px-1 py-0 m-0"><b t-esc="tax_total.get('base_name')"></b></td>
                            <td class="px-1 py-0 m-0" style="text-align: right;"><t t-esc="tax_total.get('tax_amount')"
                                                                                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                        </tr>
                        <tr t-foreach="o._get_co2_totals()" t-as="co2_total">
                            <td class="table-title px-1 py-0 m-0"><b t-esc="co2_total.get('other_name')"></b></td>
                            <td class="px-1 py-0 m-0" style="text-align: right;"><t t-esc="co2_total.get('other_amount')"
                                                                                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                        </tr>
                        <tr t-foreach="o._get_first_registration_totals()" t-as="first_total">
                            <td class="table-title px-1 py-0 m-0"><b t-esc="first_total.get('other_name')"></b></td>
                            <td class="px-1 py-0 m-0" style="text-align: right;"><t t-esc="first_total.get('other_amount')"
                                                                                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                        </tr>
                        <tr t-foreach="o._get_marbete_totals()" t-as="marbete_total">
                            <td class="table-title px-1 py-0 m-0"><b t-esc="marbete_total.get('other_name')"></b></td>
                            <td class="px-1 py-0 m-0" style="text-align: right;"><t t-esc="marbete_total.get('other_amount')"
                                                                                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                        </tr>
                        <tr>
                            <td class="table-title px-1 py-0 m-0"><b>Monto Total:</b></td>
                            <td class="px-1 py-0 m-0" style="text-align: right;"><span t-field="o.amount_total"/></td>
                        </tr>
                    </table>
                </div>
            </div>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']/thead/tr/th[@name='th_description']" position="before">
            <th t-if="display_color" name="th_color" class="text-center text-uppercase">COLOR</th>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']/tbody//t[@name='account_invoice_line_accountable']//td[@name='account_invoice_line_name']"
               position="before">
            <td name="td_color" t-if="display_color">
                <span t-field="line.color"/>
            </td>
        </xpath>
    </template>
</odoo>



