<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_rental_inherited_product_template_form" model="ir.ui.view">
        <field name="name">product.template.rental</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="after">
                <page string="FCR" name="fcr_auto">
                    <group>
                        <field name="is_marbete"/>
                        <field name="is_first_registration"/>
                        <field name="is_co2"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
