<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_fcr_receipt_history" model="ir.ui.view">
        <field name="name">sale.order.form.fcr.receipt.history</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">95</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Historial de pagos FCR" invisible="state not in ['sale', 'done']">
                    <group>
                        <group string="Resumen FCR">
                            <field name="fcr_receipt_paid_total"/>
                            <field name="fcr_receipt_balance"/>
                        </group>
                    </group>
                    <field name="fcr_receipt_history_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0" default_order="receipt_date desc, id desc">
                            <field name="receipt_date"/>
                            <field name="amount" sum="Total recibido"/>
                            <field name="currency_id"/>
                            <field name="exchange_rate" string="Tasa del día"/>
                            <field name="invoice_id" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
