<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_form_invoice_lines_inherit_custom" model="ir.ui.view">
        <field name="name">account.move.form.invoice.line.inherit.custom</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                <field name="color"/>
            </xpath>
        </field>
    </record>
</odoo>
