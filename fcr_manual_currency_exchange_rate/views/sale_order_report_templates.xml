<odoo>
    <template id="report_saleorder_document_inherit_signature" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@id='informations']" position="inside">
<!--            <div class="row" >-->
                <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-0 mt-0"
                     t-if="doc.currency_id and doc.currency_id.name != 'DOP'" name="l10n_do_currency">
                    <strong>Currency:</strong>
                    <br/>
                    <p class="m-0" t-esc="doc.currency_id.name"/>
                    (<span t-field="doc.manual_currency_exchange_rate"
                           t-options='{"widget": "monetary", "display_currency": doc.company_id.currency_id}'/>)
                </div>
<!--            </div>-->
        </xpath>
    </template>
</odoo>
