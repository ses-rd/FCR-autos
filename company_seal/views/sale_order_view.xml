<odoo>
    <record id="view_order_form_inherited" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.company.seal</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='connectors_setting_container']" position="after">
                <div name="company_seal_block" class="settings_block">
                    <h2>Company Seal</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col12 o_setting_box">
                            <field name="company_seal" widget="image"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
