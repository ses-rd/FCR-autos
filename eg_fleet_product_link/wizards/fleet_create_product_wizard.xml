<odoo>
    <record id="fleet_create_product_wizard_view" model="ir.ui.view">
        <field name="name">fleet.create.product.wizard.form</field>
        <field name="model">fleet.create.product.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="vehicle_id" readonly="1"
                           options="{'no_create': True, 'no_create_edit': True,'no_open': True}"/>
                </group>
                <group>
                    <group>
                        <field name="name" required="1"/>
                        <field name="categ_id" options="{'no_create': True, 'no_create_edit': True,'no_open': True}"
                               required="1"/>
                    </group>
                    <group>
                        <field name="type" options="{'no_create': True, 'no_create_edit': True,'no_open': True}"
                               required="1"/>
                        <field name="uom_id" options="{'no_create': True, 'no_create_edit': True,'no_open': True}"
                               required="1"/>
                    </group>
                </group>
                <footer>
                    <button string="Create Product" type="object" name="action_create_product" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>