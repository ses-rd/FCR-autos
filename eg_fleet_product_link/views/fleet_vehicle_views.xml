<odoo>
    <record id="fleet_vehicle_form_inherit_product" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.product.link</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button string="Create Product" type="object" name="action_create_product" class="btn-primary"
                        invisible="product_tmpl_id != False"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">

                <button name="action_view_product_template" type="object" class="oe_stat_button" icon="fa-bookmark"
                        invisible="product_tmpl_id == False">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Product</span>
                    </div>
                </button>
                <button name="action_view_stock_quants" type="object" class="oe_stat_button" icon="fa-cubes"
                        invisible="product_tmpl_id == False">
                    <field name="stock_quant_count" widget="statinfo" string="On Hand"/>
                </button>
                <button type="object" name="action_view_stock_move_lines" class="oe_stat_button" icon="fa-exchange"
                        invisible="product_id == False">
                    <div class="d-flex flex-column">
                        <div class="o_field_widget o_stat_info align-items-baseline flex-row gap-1 me-1">
                            <span class="o_stat_text">In:</span>
                            <span class="o_stat_value">
                                <field name="nbr_moves_in"/>
                            </span>
                        </div>
                        <div class="o_field_widget o_stat_info align-items-baseline flex-row gap-1 me-1">
                            <span class="o_stat_text">Out:</span>
                            <span class="o_stat_value">
                                <field name="nbr_moves_out"/>
                            </span>
                        </div>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>