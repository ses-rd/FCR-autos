<odoo>
    <record id="product_template_form_inherit_fleet" model="ir.ui.view">
        <field name="name">product.template.form.fleet.info</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_ok']" position="before">
                <field name="is_fleet"/>
                <label for="is_fleet" string="Is Fleet"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Fleet Information" invisible="not is_fleet">
                    <group>
                        <group>
                            <field name="vehicle_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="model_id" readonly="1"/>
                            <field name="license_plate" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>